<header class="px-6 sm:px-8 lg:px-10 border border-b-2">
  <div class="flex items-center justify-between">
    <.link navigate="/">
      <div class="flex justify-center items-center space-x-2">
        <img src={~p"/images/logo_3_croped.png"} alt="ProjeXpert Logo" class="h-12 w-12" />
        <span class="text-left text-2xl text-blue-600 font-nunito font-bold">ProjeXpert</span>
      </div>
    </.link>
    <div :if={!@current_user} class="flex items-center space-x-2">
      <.link
        :if={@socket.view != ProjeXpertWeb.UserLoginLive}
        navigate="/log_in"
        type="button"
        class="hidden md:inline-flex font-semibold text-blue-600"
      >
        Log In
      </.link>
      <.link
        :if={@socket.view != ProjeXpertWeb.UserRegistrationLive}
        navigate="/register/freelancer"
        type="button"
        class="hidden md:inline-flex font-semibold text-blue-600"
      >
        Sign Up
      </.link>
    </div>
    <div :if={@current_user} class="flex items-center space-x-4">
      <div>
        <svg
          class="w-9 h-9 text-gray-800"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
          />
        </svg>
      </div>
      <div>
        <svg
          class="w-9 h-9 text-gray-800"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"
          />
        </svg>
      </div>
      <div x-data="{ open: false }">
        <button
          @click="open = !open"
          @click.outside="open = false"
          type="button"
          class="relative flex space-x-2"
        >
          <.dot_profile_image user={@current_user} />
          <div class="flex flex-col text-left">
            <p class="text-gray-600 text-md font-medium">
              <%= full_name(@current_user) %>
            </p>
            <p class="text-gray-400 text-sm font-medium">
              <%= camel_case_string(@current_user.role) %>
            </p>
          </div>
        </button>
        <div
          x-show="open"
          class="absolute right-10 z-[60] mt-2 w-48 origin-top-right rounded-md bg-white py-1 shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none"
        >
          <li class="block px-4 py-2 text-lg text-gray-600 hover:bg-gray-100 cursor-pointer">
            <.icon name="hero-user-circle" class="w-6 h-6" /> Your Profile
          </li>
          <li class="block px-4 py-2 text-lg text-gray-600 hover:bg-gray-100 cursor-pointer">
            <.icon name="hero-cog-8-tooth" class="w-6 h-6" /> Settings
          </li>
          <.link
            href="/log_out"
            method="delete"
            class="block px-4 py-2 text-lg text-gray-600 hover:bg-gray-100"
          >
            <.icon name="hero-arrow-left-end-on-rectangle" class="w-6 h-6" /> Sign out
          </.link>
        </div>
      </div>
    </div>
  </div>
</header>
<main class={
  [!@current_user && "min-h-[94vh] flex items-center justify-center"] |> Enum.join(" ")
}>
  <.flash_group flash={@flash} />
  <div :if={@current_user} class="flex space-x-3 min-h-[94vh]">
    <!-- aside -->
    <div class="w-[18%]">
      <aside class="flex flex-col h-full space-y-2 border-r-2 border-gray-200 bg-white p-2">
        <.link
          navigate="/dashboard"
          class={[
            "flex items-center space-x-1 rounded-md px-2 py-3 hover:bg-gray-100 group",
            @active_tab == :dashboard && "font-medium bg-gray-100 text-blue-600"
          ]}
        >
          <svg
            class={[
              "w-6 h-6 group-hover:text-blue-600",
              @active_tab != :dashboard && "text-gray-800",
              @active_tab == :dashboard && "group-text-blue-600"
            ]}
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M4 4.5V19a1 1 0 0 0 1 1h15M7 14l4-4 4 4 5-5m0 0h-3.207M20 9v3.207"
            />
          </svg>

          <span class="group-hover:text-blue-600">Dashboard</span>
        </.link>
        <.link
          navigate={~p"/projects"}
          class={[
            "flex items-center space-x-1 rounded-md px-2 py-3 hover:bg-gray-100 group",
            @active_tab == :projects && "font-medium bg-gray-100 text-blue-600"
          ]}
        >
          <svg
            class={[
              "w-6 h-6 group-hover:text-blue-600",
              @active_tab != :projects && "text-gray-800",
              @active_tab == :projects && "text-blue-600"
            ]}
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M8 7H5a2 2 0 0 0-2 2v4m5-6h8M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m0 0h3a2 2 0 0 1 2 2v4m0 0v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-6m18 0s-4 2-9 2-9-2-9-2m9-2h.01"
            />
          </svg>

          <span class="group-hover:text-blue-600">Projects</span>
        </.link>
        <.link
          :if={is_freelancer?(@current_user)}
          navigate="/tasks"
          class={[
            "flex items-center space-x-1 rounded-md px-2 py-3 hover:bg-gray-100 group",
            @active_tab == :tasks && "font-medium bg-gray-100 text-blue-600"
          ]}
        >
          <svg
            class={[
              "w-6 h-6 group-hover:text-blue-600",
              @active_tab != :tasks && "text-gray-800",
              @active_tab == :tasks && "text-blue-600"
            ]}
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M10 5 9 4V3m5 2 1-1V3m-3 6v11m0-11a5 5 0 0 1 5 5m-5-5a5 5 0 0 0-5 5m5-5a4.959 4.959 0 0 1 2.973 1H15V8a3 3 0 0 0-6 0v2h.027A4.959 4.959 0 0 1 12 9Zm-5 5H5m2 0v2a5 5 0 0 0 10 0v-2m2.025 0H17m-9.975 4H6a1 1 0 0 0-1 1v2m12-3h1.025a1 1 0 0 1 1 1v2M16 11h1a1 1 0 0 0 1-1V8m-9.975 3H7a1 1 0 0 1-1-1V8"
            />
          </svg>

          <span class="group-hover:text-blue-600">Tasks</span>
        </.link>
        <.link
          :if={is_client?(@current_user)}
          navigate="/bids"
          class={[
            "flex items-center space-x-1 rounded-md px-2 py-3 hover:bg-gray-100 group",
            @active_tab == :bids && "font-medium bg-gray-100 text-blue-600"
          ]}
        >
          <svg
            class={[
              "w-6 h-6 group-hover:text-blue-600",
              @active_tab != :bids && "text-gray-800",
              @active_tab == :bids && "text-blue-600"
            ]}
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M10 11V8a1 1 0 0 0-1-1H6a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1Zm0 0v2a4 4 0 0 1-4 4H5m14-6V8a1 1 0 0 0-1-1h-3a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1Zm0 0v2a4 4 0 0 1-4 4h-1"
            />
          </svg>

          <span class="group-hover:text-blue-600">Bids</span>
        </.link>
        <.link
          navigate={~p"/channels"}
          class={[
            "flex items-center space-x-1 rounded-md px-2 py-3 hover:bg-gray-100 group",
            @active_tab == :channels && "font-medium bg-gray-100 text-blue-600"
          ]}
        >
          <svg
            class={[
              "w-6 h-6 group-hover:text-blue-600",
              @active_tab != :channels && "text-gray-800",
              @active_tab == :channels && "text-blue-600"
            ]}
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke="currentColor"
              stroke-linecap="square"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M9 17h6l3 3v-3h2V9h-2M4 4h11v8H9l-3 3v-3H4V4Z"
            />
          </svg>

          <span class="group-hover:text-blue-600">Channels</span>
        </.link>
        <.link
          navigate={~p"/settings"}
          class={[
            "flex items-center space-x-1 rounded-md px-2 py-3 hover:bg-gray-100 group",
            @active_tab == :settings && "font-medium bg-gray-100 text-blue-600"
          ]}
        >
          <svg
            class={[
              "w-6 h-6 group-hover:text-blue-600",
              @active_tab != :settings && "text-gray-800",
              @active_tab == :settings && "text-blue-600"
            ]}
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke="currentColor"
              stroke-linecap="square"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M10 19H5a1 1 0 0 1-1-1v-1a3 3 0 0 1 3-3h2m10 1a3 3 0 0 1-3 3m3-3a3 3 0 0 0-3-3m3 3h1m-4 3a3 3 0 0 1-3-3m3 3v1m-3-4a3 3 0 0 1 3-3m-3 3h-1m4-3v-1m-2.121 1.879-.707-.707m5.656 5.656-.707-.707m-4.242 0-.707.707m5.656-5.656-.707.707M12 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
            />
          </svg>

          <span class="group-hover:text-blue-600">Settings</span>
        </.link>
      </aside>
    </div>
    <div class="w-[82%] py-3 px-4 sm:py-4 sm:px-6 lg:py-4 lg:px-8">
      <%= @inner_content %>
    </div>
  </div>
  <div :if={!@current_user} class="w-full flex items-center justify-center">
    <%= @inner_content %>
  </div>
</main>
