<div class="flex flex-col">
  <header class="px-4 lg:px-6 h-14 flex items-center border-b">
    <.link navigate="/">
      <div class="flex justify-center items-center space-x-2 my-[10px]">
        <img src={~p"/images/logo.png"} alt="ProjeXpert Logo" class="h-10 w-10" />
        <span class="text-left text-2xl text-blue-600 font-bold">ProjeXpert</span>
      </div>
    </.link>
    <nav class="ml-auto flex gap-4 sm:gap-6">
      <a class="text-sm font-medium hover:underline underline-offset-4" href="#features">
        Features
      </a>
      <a class="text-sm font-medium hover:underline underline-offset-4" href="#pricing">
        Pricing
      </a>
      <a class="text-sm font-medium hover:underline underline-offset-4" href="#">About</a>
      <a class="text-sm font-medium hover:underline underline-offset-4" href="#">Contact</a>
    </nav>
  </header>
  <section class="py-12 md:py-24 lg:py-32 xl:py-48">
    <div class="container px-4 md:px-6 mx-auto">
      <div class="flex flex-col items-center space-y-4 text-center">
        <div class="space-y-2">
          <h1 class="text-3xl font-bold tracking-tighter sm:text-4xl md:text-5xl lg:text-6xl/none">
            Welcome to ProjeXpert
          </h1>
          <p class="mx-auto max-w-[700px] text-gray-500 md:text-xl">
            The ultimate task marketplace that combines freelance bidding with project management.
          </p>
        </div>
        <div class="space-x-4">
          <.link
            patch={~p"/register/freelancer"}
            class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none ring-offset-background bg-blue-600 text-white hover:bg-blue-500 h-10 py-2 px-4"
          >
            Get Started
          </.link>
          <a
            href="#"
            class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none ring-offset-background border border-input hover:bg-accent hover:text-accent-foreground h-10 py-2 px-4"
          >
            Learn More
          </a>
        </div>
      </div>
    </div>
  </section>
  <section id="features" class="w-full py-12 md:py-24 lg:py-32 bg-gray-100">
    <div class="container px-4 md:px-6 mx-auto">
      <h2 class="text-3xl font-bold text-center mb-12">Our Features</h2>
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col items-center space-y-4 text-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-12 h-12 text-blue-600"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"
            />
          </svg>
          <h3 class="text-xl font-bold">Freelance Bidding</h3>
          <p class="text-gray-500 ">
            Connect with talented freelancers and find the perfect match for your project.
          </p>
        </div>
        <div class="flex flex-col items-center space-y-4 text-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-12 h-12 text-blue-600"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z"
            />
          </svg>
          <h3 class="text-xl font-bold">Project Management</h3>
          <p class="text-gray-500">
            Efficiently manage your projects with our integrated tools and features.
          </p>
        </div>
        <div class="flex flex-col items-center space-y-4 text-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-12 h-12 text-blue-600"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
          <h3 class="text-xl font-bold">Real-time Collaboration</h3>
          <p class="text-gray-500">
            Collaborate seamlessly with your team and clients in real-time.
          </p>
        </div>
        <div class="flex flex-col items-center space-y-4 text-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-12 h-12 text-blue-600"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"
            />
          </svg>
          <h3 class="text-xl font-bold">Analytics Dashboard</h3>
          <p class="text-gray-500">
            Track project progress and team performance with detailed analytics.
          </p>
        </div>
        <div class="flex flex-col items-center space-y-4 text-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-12 h-12 text-blue-600"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
          <h3 class="text-xl font-bold">Time Tracking</h3>
          <p class="text-gray-500">
            Accurately track time spent on tasks and projects for better billing and productivity.
          </p>
        </div>
        <div class="flex flex-col items-center space-y-4 text-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-12 h-12 text-blue-600"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418"
            />
          </svg>
          <h3 class="text-xl font-bold">Global Talent Pool</h3>
          <p class="text-gray-500">
            Access a diverse range of skills from freelancers around the world.
          </p>
        </div>
      </div>
    </div>
  </section>
  <section id="pricing" class="w-full py-12 md:py-24 lg:py-32">
    <div class="container px-4 md:px-6 mx-auto">
      <h2 class="text-3xl font-bold text-center mb-12">Pricing Plans</h2>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col p-6 bg-white shadow-lg rounded-lg">
          <h3 class="text-2xl font-bold text-center">Basic</h3>
          <p class="text-center text-gray-500">
            For individuals and small teams
          </p>
          <div class="mt-4 text-center">
            <span class="text-4xl font-bold">$19</span>
            <span class="text-gray-500">/month</span>
          </div>
          <ul class="mt-4 space-y-2">
            <li class="flex items-center">
              <svg
                class="w-5 h-5 text-green-500 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                >
                </path>
              </svg>
              Up to 5 projects
            </li>
            <li class="flex items-center">
              <svg
                class="w-5 h-5 text-green-500 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                >
                </path>
              </svg>
              Basic project management tools
            </li>
            <li class="flex items-center">
              <svg
                class="w-5 h-5 text-green-500 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                >
                </path>
              </svg>
              Limited freelancer bidding
            </li>
          </ul>
          <a
            href="#"
            class="mt-6 block px-4 py-2 bg-blue-600 text-white text-center rounded-md hover:bg-blue-500"
          >
            Choose Plan
          </a>
        </div>
        <div class="flex flex-col p-6 bg-white shadow-lg rounded-l">
          <h3 class="text-2xl font-bold text-center">Pro</h3>
          <p class="text-center text-gray-500">For growing businesses</p>
          <div class="mt-4 text-center">
            <span class="text-4xl font-bold">$49</span>
            <span class="text-gray-500">/month</span>
          </div>
          <ul class="mt-4 space-y-2">
            <li class="flex items-center">
              <svg
                class="w-5 h-5 text-green-500 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                >
                </path>
              </svg>
              Unlimited projects
            </li>
            <li class="flex items-center">
              <svg
                class="w-5 h-5 text-green-500 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                >
                </path>
              </svg>
              Advanced project management tools
            </li>
            <li class="flex items-center">
              <svg
                class="w-5 h-5 text-green-500 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                >
                </path>
              </svg>
              Full freelancer bidding features
            </li>
            <li class="flex items-center">
              <svg
                class="w-5 h-5 text-green-500 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
