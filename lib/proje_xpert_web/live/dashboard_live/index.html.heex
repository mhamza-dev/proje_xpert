<div>
  <.live_component id="bread_crumb" module={ProjeXpertWeb.BreadCrumb} path={@current_path} />
  <!-- Stats Grid -->
  <div class="my-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-2">Active Projects</h2>
      <p class="text-3xl font-bold text-blue-600"><%= active_projects(@projects) %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-2">Hired Freelancers</h2>
      <p class="text-3xl font-bold text-blue-600"><%= hired_freelancers(@projects) %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-2">Completed Projects</h2>
      <p class="text-3xl font-bold text-blue-600"><%= completed_projects(@projects) %></p>
    </div>
    <div :if={is_freelancer?(@current_user)} class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-2">Total Earnings</h2>
      <p class="text-3xl font-bold text-blue-600">
        <%= Number.Currency.number_to_currency(52.750) %>
      </p>
    </div>
    <div :if={is_client?(@current_user)} class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-2">Total Spent</h2>
      <p class="text-3xl font-bold text-blue-600">
        <%= Number.Currency.number_to_currency(52.750) %>
      </p>
    </div>
  </div>
  <!-- Charts -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Project Status</h2>
      <canvas
        class="chart"
        id="projects-chart"
        phx-hook="ChartJS"
        data-chart-data={Jason.encode!(Chart.projects_chart(@projects))}
      >
      </canvas>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Freelancer Hiring Trend</h2>
      <canvas
        class="chart"
        id="tasks-chart"
        phx-hook="ChartJS"
        data-chart-data={Jason.encode!(Chart.tasks_chart(@projects))}
      >
      </canvas>
    </div>
  </div>
  <!-- Recent Projects Table -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-xl font-semibold text-gray-900">Recent Projects</h2>
    </div>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Project Name
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Client
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Status
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Deadline
          </th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <tr :for={recent_project <- recent_projects(@projects)}>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
            <%= recent_project.title %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
            <%= full_name(recent_project.client) %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <.status_pill status={recent_project.status} />
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
            <%= relative_time(recent_project.inserted_at) %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
