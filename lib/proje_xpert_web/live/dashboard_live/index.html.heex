<div>
  <.live_component id="bread_crumb" module={ProjeXpertWeb.BreadCrumb} path={@current_path} />
  <!-- Stats Grid -->
  <div class="overflow-x-auto max-h-[calc(100vh-12vh)]">
    <div class="overflow-y-scroll">
      <div class="my-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white rounded-lg shadow p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-2">Active Projects</h2>
          <p class="text-3xl font-bold text-blue-600"><%= active_projects(@projects) %></p>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-2">Hired Freelancers</h2>
          <p class="text-3xl font-bold text-blue-600"><%= hired_freelancers(@projects) %></p>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-2">Completed Projects</h2>
          <p class="text-3xl font-bold text-blue-600"><%= completed_projects(@projects) %></p>
        </div>
        <div :if={is_freelancer?(@current_user)} class="bg-white rounded-lg shadow p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-2">Total Earnings</h2>
          <p class="text-3xl font-bold text-blue-600">
            <%= Number.Currency.number_to_currency(52.750) %>
          </p>
        </div>
        <div :if={is_client?(@current_user)} class="bg-white rounded-lg shadow p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-2">Total Spent</h2>
          <p class="text-3xl font-bold text-blue-600">
            <%= Number.Currency.number_to_currency(52.750) %>
          </p>
        </div>
      </div>
      <!-- Charts -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
        <div class="bg-white rounded-lg shadow p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Project</h2>
          <canvas
            class="chart mx-auto"
            id="projects-chart"
            phx-hook="ChartJS"
            data-chart-data={Jason.encode!(Chart.projects_chart(@projects))}
          >
          </canvas>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Tasks</h2>
          <canvas
            class="chart mx-auto"
            id="tasks-chart"
            phx-hook="ChartJS"
            data-chart-data={Jason.encode!(Chart.tasks_chart(@projects))}
          >
          </canvas>
        </div>
      </div>
      <!-- Recent Projects Table -->
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-xl font-semibold text-gray-900">Recent Projects</h2>
        </div>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Project Name
              </th>
              <th
                :if={is_client?(@current_user)}
                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
              >
                Freelancers
              </th>
              <th
                :if={is_freelancer?(@current_user)}
                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
              >
                Client
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Status
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <tr :for={recent_project <- recent_projects(@projects)}>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <.link navigate={~p"/projects/#{recent_project.id}/show"}>
                  <%= recent_project.title %>
                </.link>
              </td>
              <td
                :if={is_freelancer?(@current_user)}
                class="p-3 text-sm flex space-x-2 items-center text-gray-500"
              >
                <.dot_profile_image user={recent_project.client} class="w-6 h-6 rounded-full" />
                <span><%= full_name(recent_project.client) %></span>
              </td>
              <td :if={is_client?(@current_user)} class="p-3 text-sm">
                <div class="flex items-center">
                  <% bids = get_freelancers_of_a_project(recent_project) %>
                  <div :if={!Enum.empty?(bids)}>
                    <.tooltip
                      :if={Enum.count(bids) > 2}
                      data={bids |> Enum.map(&full_name(&1)) |> Enum.join(", ")}
                    >
                      <:inner_button>
                        <% [hd | tl] = Enum.chunk_every(bids, 2) %>
                        <div class="flex items-center">
                          <%= for user <- hd do %>
                            <.profile_image
                              user={user}
                              class="object-cover w-6 h-6 -mx-1 border-2 border-white rounded-full shrink-0"
                            />
                          <% end %>
                          <p class="flex items-center justify-center w-6 h-6 -mx-1 text-xs text-blue-600 bg-blue-100 border-2 border-white rounded-full">
                            +<%= length(List.flatten(tl)) %>
                          </p>
                        </div>
                      </:inner_button>
                    </.tooltip>
                    <.tooltip
                      :if={Enum.count(bids) <= 2}
                      data={bids |> Enum.map(&full_name(&1)) |> Enum.join(", ")}
                    >
                      <:inner_button>
                        <div class="flex items-center">
                          <%= for user <- bids do %>
                            <.profile_image
                              user={user}
                              class="object-cover w-6 h-6 -mx-1 border-2 border-white rounded-full shrink-0"
                            />
                          <% end %>
                        </div>
                      </:inner_button>
                    </.tooltip>
                  </div>
                  <div :if={Enum.empty?(bids)}>
                    --------
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <.status_pill status={recent_project.status} />
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
