<!-- component -->
<div>
  <div class="flex items-center justify-between space-x-2 my-2">
    <.live_component
      id="bread_crumb"
      module={ProjeXpertWeb.BreadCrumb}
      path={@current_path}
      title={@project.title}
    />
    <div class="flex items-center  space-x-2 my-2">
      <.form
        :let={sp}
        :if={@kanban_board}
        for={%{}}
        as={:select_sprint}
        phx-change="select_sprint"
      >
        <.input
          type="select"
          field={sp[:sprint_id]}
          class="w-24"
          value={@selected_sprint.id}
          options={@sprint_options}
        />
      </.form>
      <.button
        :if={!@kanban_board}
        type="button"
        class="mt-2"
        style="secondary"
        phx-click="kanban_board"
      >
        Show Kanban
      </.button>
      <.button
        :if={@kanban_board}
        type="button"
        class="mt-2"
        style="secondary"
        phx-click="kanban_board"
      >
        Show Description
      </.button>
      <.dropdown
        :if={is_client?(@current_user)}
        with_dots={false}
        label="Actions"
        ticket_dropdown="right-[6.5rem] w-48"
      >
        <ul>
          <li class="p-2 text-lg text-gray-600 hover:bg-gray-100 cursor-pointer group">
            <.link
              patch={~p"/projects/show/#{@project.id}/edit?kanban_board=#{@kanban_board}"}
              class="flex w-auto p-1 text-sm tracking-wide space-x-2"
            >
              <svg
                class="w-5 h-5 group-hover:text-blue-500"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                fill="none"
                viewBox="0 0 24 24"
              >
                <path
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="m14.304 4.844 2.852 2.852M7 7H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-4.5m2.409-9.91a2.017 2.017 0 0 1 0 2.853l-6.844 6.844L8 14l.713-3.565 6.844-6.844a2.015 2.015 0 0 1 2.852 0Z"
                />
              </svg>
              <span class="group-hover:text-blue-500">Edit Project</span>
            </.link>
          </li>
          <li
            :if={@kanban_board and @selected_sprint.status != :completed}
            phx-click="complete_sprint"
            phx-value-id={@selected_sprint.id}
            class="p-2 text-lg text-gray-600 hover:bg-gray-100 cursor-pointer group"
          >
            <div class="flex w-auto p-1 text-sm tracking-wide space-x-2">
              <svg
                class="w-5 h-5 group-hover:text-green-500"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                fill="none"
                viewBox="0 0 24 24"
              >
                <path
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M8.5 11.5 11 14l4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                />
              </svg>
              <span class="group-hover:text-green-500">Complete Sprint</span>
            </div>
          </li>
          <li
            :if={@kanban_board and @selected_sprint.status != :completed}
            class="p-2 text-lg text-gray-600 hover:bg-gray-100 cursor-pointer group"
          >
            <.link
              patch={
                ~p"/projects/#{@project.id}/sprints/#{@selected_sprint.id}/edit?kanban_board=#{@kanban_board}"
              }
              class="flex w-auto p-1 text-sm tracking-wide space-x-2"
            >
              <svg
                class="w-5 h-5 group-hover:text-blue-500"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="m14.304 4.844 2.852 2.852M7 7H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-4.5m2.409-9.91a2.017 2.017 0 0 1 0 2.853l-6.844 6.844L8 14l.713-3.565 6.844-6.844a2.015 2.015 0 0 1 2.852 0Z"
                />
              </svg>
              <span class="group-hover:text-blue-500">Edit Selected Sprint</span>
            </.link>
          </li>
          <li class="p-2 text-lg text-gray-600 hover:bg-gray-100 cursor-pointer group">
            <.link
              :if={@project.status != :completed}
              patch={~p"/projects/#{@project.id}/new_sprint?kanban_board=#{@kanban_board}"}
              class="flex w-auto p-1 text-sm tracking-wide space-x-2"
            >
              <svg
                class="w-5 h-5 group-hover:text-blue-500"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M12 4v16m8-8H4"
                />
              </svg>
              <span class="group-hover:text-blue-500">New Sprint</span>
            </.link>
          </li>
          <li class="p-2 text-lg text-gray-600 hover:bg-gray-100 cursor-pointer group">
            <.link
              :if={@project.status != :completed}
              patch={~p"/projects/#{@project.id}/new_column?kanban_board=#{@kanban_board}"}
              class="flex w-auto p-1 text-sm tracking-wide space-x-2"
            >
              <svg
                class="w-5 h-5 group-hover:text-blue-500"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M12 4v16m8-8H4"
                />
              </svg>
              <span class="group-hover:text-blue-500">Add Column</span>
            </.link>
          </li>
          <li class="p-2 text-lg text-gray-600 hover:bg-gray-100 cursor-pointer group">
            <.link
              :if={@project.status != :completed}
              patch={~p"/projects/#{@project.id}/new_task?kanban_board=#{@kanban_board}"}
              class="flex w-auto p-1 text-sm tracking-wide space-x-2"
            >
              <svg
                class="w-5 h-5 group-hover:text-blue-500"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M12 4v16m8-8H4"
                />
              </svg>
              <span class="group-hover:text-blue-500">Add Task</span>
            </.link>
          </li>
          <li
            :if={is_nil(@project.channel) and @project.status != :completed}
            class="p-2 text-lg text-gray-600 hover:bg-gray-100 cursor-pointer group"
          >
            <.link
              patch={~p"/projects/#{@project.id}/channels/new"}
              class="flex w-auto p-1 text-sm tracking-wide space-x-2"
            >
              <svg
                class="w-5 h-5 group-hover:text-blue-500"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M12 4v16m8-8H4"
                />
              </svg>
              <span class="group-hover:text-blue-500">Create Channel</span>
            </.link>
          </li>
          <li
            :if={!is_nil(@project.channel)}
            class="p-2 text-lg text-gray-600 hover:bg-gray-100 cursor-pointer group"
          >
            <.link
              navigate={~p"/channels/#{@project.channel.id}/show"}
              class="flex w-auto p-1 text-sm tracking-wide space-x-2"
            >
              <svg
                class="5-4 5-4 group-hover:text-yellow-500"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                fill="none"
                viewBox="0 0 24 24"
              >
                <path
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M19 12H5m14 0-4 4m4-4-4-4"
                />
              </svg>
              <span class="group-hover:text-yellow-500">View Channel</span>
            </.link>
          </li>
        </ul>
      </.dropdown>
      <.dropdown
        :if={is_freelancer?(@current_user) and !is_nil(@project.channel)}
        with_dots={false}
        label="Actions"
        ticket_dropdown="right-[6.5rem] w-48"
      >
        <ul>
          <li class="p-2 text-lg text-gray-600 hover:bg-gray-100 cursor-pointer group">
            <.link
              navigate={~p"/channels/#{@project.channel.id}/show"}
              class="flex w-auto p-1 text-sm tracking-wide space-x-2"
            >
              <svg
                class="5-4 5-4 group-hover:text-yellow-500"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                fill="none"
                viewBox="0 0 24 24"
              >
                <path
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M19 12H5m14 0-4 4m4-4-4-4"
                />
              </svg>
              <span class="group-hover:text-yellow-500">View Channel</span>
            </.link>
          </li>
        </ul>
      </.dropdown>
    </div>
  </div>

  <div class="my-6 flex items-center justify-between">
    <div class="flex text-md font-semibold">
      Budget:
      <span class="text-green-500">
        <%= Number.Currency.number_to_currency(@project.budget) %>
      </span>
    </div>
    <div class="flex">
      <div class="relative flex items-center mt-4 md:mt-0">
        <span class="absolute">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-5 h-5 mx-3 text-gray-400 "
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
            />
          </svg>
        </span>

        <input
          type="text"
          placeholder="Search"
          class="block w-full py-1.5 pr-5 text-gray-700 bg-white border border-gray-200 rounded-lg md:w-80 placeholder-gray-400/70 pl-11 rtl:pr-11 rtl:pl-5 focus:border-blue-400 focus:ring-blue-300 focus:outline-none focus:ring focus:ring-opacity-40"
        />
      </div>
    </div>
  </div>
  <div :if={!@kanban_board} class="text-lg">
    <%= raw(@project.description) %>
  </div>

  <div :if={@kanban_board} class="flex flex-col">
    <div class="min-w-full align-middle">
      <div class="border border-gray-200 md:rounded-lg">
        <div class="flex space-x-6 p-4 h-[calc(100vh-15rem)] overflow-x-scroll">
          <div
            :for={column <- Enum.sort_by(@selected_sprint.columns, & &1.name, :asc)}
            class="relative flex flex-col text-gray-700 bg-white shadow-md border rounded-xl w-64 overflow-y-scroll"
            id={"dragHook#{column.id}"}
            phx-hook="dragHook"
          >
            <div class={
              [
                "flex items-center bg-gray-50 px-2 py-4 border-b-2 rounded-xl sticky top-0 z-10",
                column.name in Column.get_default_columns() && "justify-center",
                column.name not in Column.get_default_columns() and is_client?(@current_user) &&
                  "justify-between",
                is_freelancer?(@current_user) && "justify-center"
              ]
              |> Enum.join(" ")
            }>
              <div class="flex space-x-3 ml-4">
                <p class="text-center text-md font-semibold text-ellipsis whitespace-nowrap overflow-hidden max-w-[150px]">
                  <%= column.name %>
                </p>
                <p class="flex h-2 w-2 items-center justify-center rounded-full bg-red-500 p-3 text-xs text-white">
                  <%= length(get_tasks_by_current_user(@current_user, column.tasks)) %>
                </p>
              </div>

              <.dropdown
                :if={
                  is_client?(@current_user) and column.name not in Column.get_default_columns()
                }
                ticket_dropdown="right-[1.5rem] w-32"
              >
                <ul>
                  <.link
                    patch={
                      ~p"/projects/#{@project.id}/column/#{column.id}/edit?kanban_board=#{@kanban_board}"
                    }
                    class="flex items-center space-x-2 px-4 py-2 text-[1rem] text-gray-600 hover:bg-gray-100 cursor-pointer group"
                  >
                    <svg
                      class="w-6 h-6 group-hover:text-blue-600/50"
                      aria-hidden="true"
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      fill="none"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.5"
                        d="m14.304 4.844 2.852 2.852M7 7H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-4.5m2.409-9.91a2.017 2.017 0 0 1 0 2.853l-6.844 6.844L8 14l.713-3.565 6.844-6.844a2.015 2.015 0 0 1 2.852 0Z"
                      />
                    </svg>
                    <span class="group-hover:text-blue-600/50">Edit</span>
                  </.link>
                  <li
                    class="flex items-center space-x-2 px-4 py-2 text-[1rem] text-gray-600 hover:bg-gray-100 cursor-pointer group"
                    phx-click="delete_column"
                    phx-value-id={column.id}
                  >
                    <svg
                      class="w-6 h-6 group-hover:text-red-500"
                      aria-hidden="true"
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      fill="none"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.5"
                        d="M5 7h14m-9 3v8m4-8v8M10 3h4a1 1 0 0 1 1 1v3H9V4a1 1 0 0 1 1-1ZM6 7h12v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7Z"
                      />
                    </svg>
                    <span class="group-hover:text-red-500">Delete</span>
                  </li>
                </ul>
              </.dropdown>
            </div>

            <div id={"#{column.id}"} class="dropzone h-full">
              <%= for task <- get_tasks_by_current_user(@current_user, column.tasks) do %>
                <div class="draggable p-2" id={"##{task.id}"} draggable="true">
                  <div class="border border-1 rounded-lg">
                    <div class="relative mx-4 mt-4 overflow-hidden text-gray-700 bg-white bg-clip-border rounded-xl w-[90%] h-24">
                      <img
                        src="https://images.unsplash.com/photo-1629367494173-c78a56567877?ixlib=rb-4.0.3&amp;ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&amp;auto=format&amp;fit=crop&amp;w=927&amp;q=80"
                        alt="card-image"
                        class="object-cover w-full h-full"
                      />
                    </div>
                    <div class="p-6">
                      <div class="flex items-center justify-between mb-2">
                        <.link
                          patch={
                            ~p"/projects/#{@project.id}/tasks/#{task.id}/show?kanban_board=#{@kanban_board}"
                          }
                          class="hover:text-blue-600/50"
                        >
                          <p class="block font-sans text-base antialiased font-medium leading-relaxed text-blue-gray-900">
                            <%= task.title %>
                          </p>
                        </.link>
                        <.dropdown
                          :if={is_freelancer?(@current_user) and column.name == "Completed"}
                          ticket_dropdown="right-[1.5rem] w-48"
                        >
                          <ul>
                            <li
                              class="flex items-center space-x-2 px-4 py-2 text-md text-gray-600 hover:bg-gray-100 cursor-pointer group"
                              phx-click="ask_for_payment"
                              phx-value-id={task.id}
                            >
                              <svg
                                class="w-5 h-5 group-hover:text-green-500"
                                aria-hidden="true"
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                fill="none"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke="currentColor"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="1.5"
                                  d="M8 17.345a4.76 4.76 0 0 0 2.558 1.618c2.274.589 4.512-.446 4.999-2.31.487-1.866-1.273-3.9-3.546-4.49-2.273-.59-4.034-2.623-3.547-4.488.486-1.865 2.724-2.899 4.998-2.31.982.236 1.87.793 2.538 1.592m-3.879 12.171V21m0-18v2.2"
                                />
                              </svg>
                              <span class="group-hover:text-green-500">Ask for Payment</span>
                            </li>
                          </ul>
                        </.dropdown>
                        <.dropdown
                          :if={is_client?(@current_user)}
                          ticket_dropdown="right-[1.5rem] w-32"
                        >
                          <ul>
                            <.link
                              patch={
                                ~p"/projects/#{@project.id}/tasks/#{task.id}/edit?kanban_board=#{@kanban_board}"
                              }
                              class="flex items-center space-x-2 px-4 py-2 text-[1rem] text-gray-600 hover:bg-gray-100 cursor-pointer group"
                            >
                              <svg
                                class="w-6 h-6 group-hover:text-blue-600/50"
                                aria-hidden="true"
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                fill="none"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke="currentColor"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="1.5"
                                  d="m14.304 4.844 2.852 2.852M7 7H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-4.5m2.409-9.91a2.017 2.017 0 0 1 0 2.853l-6.844 6.844L8 14l.713-3.565 6.844-6.844a2.015 2.015 0 0 1 2.852 0Z"
                                />
                              </svg>
                              <span class="group-hover:text-blue-600/50">Edit</span>
                            </.link>
                            <li
                              class="flex items-center space-x-2 px-4 py-2 text-[1rem] text-gray-600 hover:bg-gray-100 cursor-pointer group"
                              phx-click="delete_task"
                              phx-value-id={task.id}
                            >
                              <svg
                                class="w-6 h-6 group-hover:text-red-500"
                                aria-hidden="true"
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                fill="none"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke="currentColor"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="1.5"
                                  d="M5 7h14m-9 3v8m4-8v8M10 3h4a1 1 0 0 1 1 1v3H9V4a1 1 0 0 1 1-1ZM6 7h12v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7Z"
                                />
                              </svg>
                              <span class="group-hover:text-red-500">Delete</span>
                            </li>
                          </ul>
                        </.dropdown>
                      </div>

                      <p class="mb-2 block font-sans text-base antialiased font-medium leading-relaxed text-blue-gray-900">
                        Budget: <%= Number.Currency.number_to_currency(task.budget) %>
                      </p>
                      <div class="antialiased font-normal leading-normal text-gray-700 overflow-hidden text-ellipsis line-clamp-3">
                        <%= raw(task.description) %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <.modal
    :if={@live_action in [:new_column, :edit_column]}
    show={@live_action in [:new_column, :edit_column]}
    id="project_modal"
    max_width="max-w-5xl"
    on_cancel={JS.navigate(~p"/projects/#{@project.id}/show?kanban_board=#{@kanban_board}")}
  >
    <.live_component
      module={Components.Column}
      id={@column.id || :new}
      title={@page_title}
      action={@live_action}
      project={@project}
      column={@column}
      sprint={@selected_sprint}
      current_user={@current_user}
    />
  </.modal>
  <.modal
    :if={@live_action in [:new_sprint, :edit_sprint]}
    show={@live_action in [:new_sprint, :edit_sprint]}
    id="task_modal"
    max_width="max-w-7xl"
    on_cancel={JS.navigate(~p"/projects/#{@project.id}/show?kanban_board=#{@kanban_board}")}
  >
    <.live_component
      module={Components.Sprint}
      id={@sprint.id || :new}
      title={@page_title}
      action={@live_action}
      sprint={@sprint}
      project={@project}
      current_user={@current_user}
    />
  </.modal>
  <.modal
    :if={@live_action in [:new_task, :edit_task, :show_task]}
    show={@live_action in [:new_task, :edit_task, :show_task]}
    id="task_modal"
    max_width="max-w-7xl"
    on_cancel={JS.navigate(~p"/projects/#{@project.id}/show?kanban_board=#{@kanban_board}")}
  >
    <.live_component
      module={Components.Task}
      id={@task.id || :new}
      title={@page_title}
      action={@live_action}
      project={@project}
      sprint={@selected_sprint}
      columns={@columns}
      task={@task}
      current_user={@current_user}
    />
  </.modal>
  <.modal
    :if={@live_action == :edit}
    show={@live_action == :edit}
    id="project_modal"
    max_width="max-w-5xl"
    on_cancel={JS.navigate(~p"/projects/#{@project.id}/show?kanban_board=#{@kanban_board}")}
  >
    <.live_component
      module={Components.Project}
      id={@project.id}
      title={@page_title}
      action={@live_action}
      project={@project}
      current_user={@current_user}
    />
  </.modal>
  <.modal
    :if={@live_action == :new_channel}
    show={@live_action == :new_channel}
    id="channel_modal"
    max_width="max-w-3xl"
    on_cancel={JS.navigate(~p"/projects/#{@project.id}/show?kanban_board=#{@kanban_board}")}
  >
    <.live_component
      module={Components.Channel}
      id={@project.id}
      title={@page_title}
      action={@live_action}
      project={@project}
      channel={@channel}
      current_user={@current_user}
    />
  </.modal>
</div>
