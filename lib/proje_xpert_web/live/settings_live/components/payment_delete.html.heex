<div>
  <div class="p-6">
    <div class="flex items-center justify-center space-x-4 mb-2">
      <svg
        class="h-6 w-6 text-red-600"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"
        />
      </svg>
      <h3 class="text-xl font-semibold text-gray-900 text-center">
        Delete Payment Method
      </h3>
    </div>
    <div class="mt-2">
      <p class="text-sm text-gray-500 text-center">
        Are you sure you want to delete this payment method? This action cannot be undone.
      </p>
    </div>
    <!-- Payment Method Info -->
    <div class="mt-4 p-4 bg-gray-50 rounded-lg">
      <div class="flex items-center space-x-4">
        <div class="flex-shrink-0">
          <svg
            class="h-8 w-8 text-gray-400"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z"
            />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-gray-900">
            <%= camel_case_string(@payment_method.brand) %> ending in <%= @payment_method.last_four_digits %>
          </p>
          <p class="text-sm text-gray-500">
            Expires <%= @payment_method.expiry %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="rounded-b-xl px-6 py-4">
    <div class="flex justify-end">
      <.button
        class="inline-flex w-full justify-center rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 sm:w-auto sm:ml-2"
        phx-click="confirm_delete"
        phx-target={@myself}
      >
        Delete Payment Method
      </.button>
    </div>
  </div>
</div>
