<div class="mt-3 min-w-5xl">
  <h3 class="text-lg leading-6 font-medium text-gray-900 text-center"><%= @title %></h3>
  <div class="mt-2 px-7 py-3">
    <.form
      :let={f}
      for={@changeset}
      phx-change="validate"
      phx-submit="save"
      phx-target={@myself}
      class="flex flex-col space-y-4"
    >
      <.input type="hidden" field={f[:user_id]} value={@current_user.id} />
      <.input
        type="text"
        field={f[:last_four_digits]}
        class="w-full"
        placeholder="1234 5678 9012 3456"
        label="Card Number"
        required
      />

      <.input
        type="text"
        field={f[:card_holder_name]}
        class="w-full"
        placeholder="John Doe"
        label="Name on Card"
        required
      />
      <div class="flex justify-between">
        <div class="w-1/2 pr-2">
          <.input
            type="text"
            field={f[:expiry]}
            class="w-full"
            placeholder="11/25"
            label="Expiry"
            required
          />
        </div>
        <div class="w-1/2 pl-2">
          <.input
            type="text"
            field={f[:cvv]}
            class="w-full"
            placeholder="12345"
            label="CVV"
            required
          />
        </div>
      </div>
      <.button type="submit">
        Add Payment Method
      </.button>
    </.form>
  </div>
</div>
