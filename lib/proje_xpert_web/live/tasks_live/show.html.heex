<div>
  <div class="flex items-center justify-between space-x-2 my-3">
    <.live_component
      id="bread_crumb"
      module={ProjeXpertWeb.BreadCrumb}
      path={@current_path}
      title={@task.title}
    />
  </div>
  <div class="flex flex-col lg:flex-row gap-8">
    <!-- Main content -->
    <div class="lg:w-2/3 max-h-[750px] overflow-y-scroll">
      <div class="p-8 bg-white rounded-xl shadow-md overflow-hidden mb-8">
        <div class="prose max-w-none">
          <h3 class="text-xl font-semibold text-gray-800 mb-4">Task Description</h3>
          <div class="text-gray-600 mb-6">
            <%= raw(@task.description) %>
          </div>
        </div>
        <div class="text-blue-500 flex items-center justify-end">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 mr-2"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z"
              clip-rule="evenodd"
            />
          </svg>
          <span>Posted <%= relative_time(@task.inserted_at) %></span>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div
          :if={user_already_bidded?(@current_user, @task.bids)}
          class="bg-white shadow rounded-lg p-6 mb-6"
        >
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-xl font-semibold text-gray-800">Proposal Already Submitted</h3>
            <.link
              class="text-md font-semibold text-gray-500 hover:text-blue-500 hover:underline"
              navigate={~p"/projects/#{@task.project_id}/show"}
            >
              Go to project
            </.link>
          </div>
          <% user_bid = get_user_bid(@current_user, @task.bids) %>
          <div class="space-y-4">
            <div>
              <p class="text-sm font-medium text-gray-500">Bid Amount</p>
              <p class="text-lg font-semibold text-green-500">
                <%= Number.Currency.number_to_currency(user_bid.amount) %>
              </p>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">Cover Letter</p>
              <p class="text-gray-600">
                <%= raw(user_bid.description) %>
              </p>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">Attachments</p>
              <ul
                :if={!is_nil(user_bid.attached_files)}
                class="list-disc list-inside text-blue-600"
              >
                <.link
                  :for={{attachemnt, index} <- Enum.with_index(user_bid.attached_files)}
                  navigate={~p"/tasks/#{@task.id}/show?source=#{attachemnt}&title=#{index + 1}"}
                  class="hover:underline"
                >
                  <li>Attachment: <%= "#{index + 1}" %></li>
                </.link>
              </ul>
              <ul
                :if={is_nil(user_bid.attached_files)}
                class="list-disc list-inside text-blue-600"
              >
                <li>No Attachments</li>
              </ul>
            </div>
          </div>
        </div>

        <div :if={!user_already_bidded?(@current_user, @task.bids)} class="p-8">
          <h3 class="text-2xl font-bold text-gray-800 mb-6">Submit a Proposal</h3>
          <.form
            :let={f}
            for={@changeset}
            phx-change="validate_bid"
            phx-submit="create_bid"
            class="flex flex-col space-y-4"
          >
            <div class="mb-6">
              <.input field={f[:freelancer_id]} type="hidden" value={@current_user.id} />
              <.input field={f[:task_id]} type="hidden" value={@task.id} />
              <label for="rate" class="block text-sm font-medium text-gray-700 mb-2">
                Bid Amount ($)
              </label>
              <.input
                field={f[:amount]}
                type="number"
                class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                required
              />
            </div>
            <div class="mb-6">
              <label for="coverLetter" class="block text-sm font-medium text-gray-700 mb-2">
                Cover Letter
              </label>
              <.text_editor field={f[:description]} id="bid-description" />
            </div>
            <.upload_attachments label="Attchments" upload_field={@uploads.cv} />
            <button
              type="submit"
              class="w-full bg-blue-500 text-white font-semibold py-3 px-4 rounded-md hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition duration-150 ease-in-out"
            >
              Submit Proposal
            </button>
          </.form>
        </div>
      </div>
    </div>
    <!-- Sidebar -->
    <div class="lg:w-1/3">
      <div class="bg-white rounded-xl shadow-md overflow-hidden mb-8">
        <div class="p-6">
          <h3 class="text-xl font-bold text-gray-800 mb-4">Task Details</h3>
          <ul class="space-y-4">
            <li class="flex justify-between items-center">
              <span class="text-gray-600">Project:</span>
              <span class="font-semibold text-blue-500"><%= @task.project.title %></span>
            </li>
            <li class="flex justify-between items-center">
              <span class="text-gray-600">Budget:</span>
              <span class="font-semibold text-blue-500">
                <%= Number.Currency.number_to_currency(@task.budget) %>
              </span>
            </li>
            <li class="flex justify-between items-center">
              <span class="text-gray-600">Deadline:</span>
              <span class="font-semibold text-blue-500"><%= @task.deadline %></span>
            </li>
            <li class="flex justify-between items-center">
              <span class="text-gray-600">Experience Level:</span>
              <span class="font-semibold text-blue-500">
                <%= camel_case_string(@task.experience_required) %>
              </span>
            </li>
          </ul>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="p-6">
          <h3 class="text-xl font-bold text-gray-800 mb-4">About the Client</h3>
          <ul class="space-y-4">
            <li class="flex justify-between items-center">
              <span class="text-gray-600">Location:</span>
              <span class="font-semibold"><%= @task.project.client.location %></span>
            </li>
            <li class="flex justify-between items-center">
              <span class="text-gray-600">Member Since:</span>
              <span class="font-semibold">
                <%= relative_time(@task.project.client.inserted_at) %>
              </span>
            </li>
            <li class="flex justify-between items-center">
              <span class="text-gray-600">Avg. Task Rate:</span>
              <span class="font-semibold">
                <%= Number.Currency.number_to_currency(
                  client_average_task_budget(@task.project.client)
                ) %>
              </span>
            </li>
            <li class="flex justify-between items-center">
              <span class="text-gray-600">Rating:</span>
              <span class="font-semibold">
                <!-- ratings_live.html.leex -->
                <div class="flex items-center">
                  <%= for star <- 1..5 do %>
                    <div class="flex items-center">
                      <%= if star <= floor(@task.project.client.rating) do %>
                        <!-- Full Star -->
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-6 w-6 text-yellow-500"
                          fill="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path d="M12 .587l3.668 7.431 8.332 1.207-6.001 5.848 1.417 8.267L12 18.896l-7.416 3.895 1.417-8.267-6.001-5.848 8.332-1.207z" />
                        </svg>
                      <% else %>
                        <%= if star <= @task.project.client.rating do %>
                          <!-- Half Star -->
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-6 w-6 text-yellow-500"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path d="M12 .587l3.668 7.431 8.332 1.207-6.001 5.848 1.417 8.267L12 18.896l-7.416 3.895 1.417-8.267-6.001-5.848 8.332-1.207z" />
                            <path fill="none" d="M0 0h24v24H0z" />
                            <path
                              d="M12 2l3.668 7.431 8.332 1.207-6.001 5.848 1.417 8.267L12 18.896l-7.416 3.895 1.417-8.267-6.001-5.848 8.332-1.207z"
                              fill="currentColor"
                              opacity="0.5"
                            />
                          </svg>
                        <% else %>
                          <!-- Empty Star -->
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-6 w-6 text-gray-300"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path d="M12 .587l3.668 7.431 8.332 1.207-6.001 5.848 1.417 8.267L12 18.896l-7.416 3.895 1.417-8.267-6.001-5.848 8.332-1.207z" />
                          </svg>
                        <% end %>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </span>
            </li>
            <li class="flex justify-between items-center">
              <span class="text-gray-600">Total Spent:</span>
              <span class="font-semibold">$25,000+</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<.modal
  :if={@show_attachment}
  show={@show_attachment}
  id="attachment_modal"
  max_width="max-w[900px]"
  on_cancel={JS.navigate(~p"/tasks/#{@task.id}/show")}
>
  <.live_component
    module={ProjeXpertWeb.Attchements}
    id="attachment_modal_component"
    title={@page_title}
    source={@source}
    redirect_to={~p"/tasks/#{@task.id}/show"}
    current_user={@current_user}
  />
</.modal>
