<td style="padding: 40px 30px;">
  <h1 style="color: #333333; font-size: 24px; margin-bottom: 20px; text-align: center;">
    Email Address Update
  </h1>
  <p style="color: #666666; font-size: 16px; margin-bottom: 20px;">
    You've updated the email address associated with your ProjeXpert account. Your email has been changed from:
  </p>
  <p style="color: #333333; font-size: 18px; font-weight: bold; text-align: center; margin-bottom: 10px;">
    <%= assigns[:old_email] %>
  </p>
  <p style="color: #666666; font-size: 16px; text-align: center; margin-bottom: 10px;">
    to
  </p>
  <p style="color: #333333; font-size: 18px; font-weight: bold; text-align: center; margin-bottom: 20px;">
    <%= assigns[:email] %>
  </p>
  <p style="color: #666666; font-size: 16px; margin-bottom: 20px;">
    If you made this change, no further action is required. If you didn't request this change, please contact our support team immediately.
  </p>
  <table width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center">
        <a
          href="mailto:messeydonna@gmail.com"
          style="display: inline-block; background-color: #1D4ED8; color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 4px; font-weight: bold; font-size: 16px;"
        >
          Contact Support
        </a>
      </td>
    </tr>
  </table>
</td>
